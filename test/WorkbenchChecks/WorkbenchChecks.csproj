<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/AdaptiveCardWorkbench/Models/*.cs" />
    <Compile Include="../../src/AdaptiveCardWorkbench/Services/DraftStorageService.cs" />
    <Compile Include="../../src/AdaptiveCardWorkbench/Services/WorkbenchJsonSerializerContext.cs" />
    <Compile Include="../../src/AdaptiveCardWorkbench/Services/WorkspaceService.cs" />
    <Compile Include="../../src/AdaptiveCardWorkbench/Services/JsonFormatting.cs" />
    <Compile Include="../../src/AdaptiveCardWorkbench/Services/AdaptiveCardCompletion.cs" />
    <EmbeddedResource Include="../../src/AdaptiveCardWorkbench/Assets/adaptive-card.json" LogicalName="AdaptiveCardWorkbench.adaptive-card.json" />
    <EmbeddedResource Include="../../src/AdaptiveCardWorkbench/Assets/Schemas/*.json" LogicalName="AdaptiveCardWorkbench.Schemas.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
