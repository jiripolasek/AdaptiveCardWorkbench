<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AdaptiveCardWorkbench.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    AutomationProperties.Name="Workbench settings"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <x:Double x:Key="SettingsCardWrapThreshold">560</x:Double>
        <x:Double x:Key="SettingsCardWrapNoIconThreshold">360</x:Double>
    </Page.Resources>

    <ScrollViewer HorizontalContentAlignment="Stretch">
        <StackPanel
            MaxWidth="720"
            Padding="28,24"
            HorizontalAlignment="Stretch"
            Spacing="24">
            <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Settings" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Personalize the card editing environment." />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock
                    Margin="0,0,0,6"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Appearance" />

                <toolkit:SettingsCard Description="Use the Windows setting or choose a theme for the workbench." Header="App theme">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        Width="156"
                        AutomationProperties.Name="App theme"
                        ItemsSource="{x:Bind ViewModel.AppThemes, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedAppThemeIndex, Mode=TwoWay}" />
                </toolkit:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock
                    Margin="0,0,0,6"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Editor" />

                <toolkit:SettingsCard Description="Size in points, applied immediately to both JSON editors." Header="Font size">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8D2;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <NumberBox
                        Width="112"
                        AutomationProperties.Name="Editor font size"
                        Maximum="24"
                        Minimum="10"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.EditorFontSize, Mode=TwoWay}" />
                </toolkit:SettingsCard>

                <toolkit:SettingsCard Description="Choose a monospace typeface for both JSON editors." Header="Font family">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8D2;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        Width="220"
                        AutomationProperties.Name="Editor font family"
                        ItemsSource="{x:Bind ViewModel.MonospaceFontFamilies, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.EditorFontFamily, Mode=TwoWay}" />
                </toolkit:SettingsCard>

                <toolkit:SettingsCard Description="{x:Bind ViewModel.EditorPreviewDescription, Mode=OneWay}" Header="Editor preview">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <TextBlock
                        FontFamily="{x:Bind ViewModel.EditorPreviewFontFamily, Mode=OneWay}"
                        FontSize="{x:Bind ViewModel.EditorFontSize, Mode=OneWay}"
                        Text="AdaptiveCard · TextBlock · ActionSet" />
                </toolkit:SettingsCard>

                <toolkit:SettingsCard Description="{x:Bind ViewModel.EditorDefaultsDescription, Mode=OneTime}" Header="Editor defaults">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE777;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <Button
                        AutomationProperties.Name="Reset editor font"
                        Command="{x:Bind ViewModel.ResetEditorSettingsCommand}"
                        Content="Reset" />
                </toolkit:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock
                    Margin="0,0,0,6"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="About" />

                <toolkit:SettingsExpander Description="© Jiří Polášek 2026. All rights reserved." Header="Win UI Adaptive Card Workbench">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </toolkit:SettingsExpander.HeaderIcon>

                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.VersionText, Mode=OneTime}" />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
                            <StackPanel Margin="-12,0,0,0" Orientation="Vertical">
                                <HyperlinkButton
                                    AutomationProperties.Name="Open the author homepage"
                                    Content="Homepage"
                                    NavigateUri="https://jiripolasek.com/en/" />
                                <HyperlinkButton
                                    AutomationProperties.Name="Open the author GitHub profile"
                                    Content="GitHub"
                                    NavigateUri="https://github.com/jiripolasek" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <HyperlinkButton
                    Margin="0,8,0,0"
                    Content="Send feedback"
                    NavigateUri="https://github.com/jiripolasek" />

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
