<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AdaptiveCardWorkbench.Pages.ArchivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewModels="using:AdaptiveCardWorkbench.ViewModels"
    AutomationProperties.Name="Archive"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <Style x:Key="ArchiveGroupContainerStyle" TargetType="ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid
        Padding="28,24"
        HorizontalAlignment="Stretch"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Archive" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Archived work stays grouped by its original project. Restore it when needed or remove it permanently."
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <ScrollViewer
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="Archived projects and cards"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.ArchiveVisibility, Mode=OneWay}">
                <ItemsControl
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    ItemContainerStyle="{StaticResource ArchiveGroupContainerStyle}"
                    ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ArchiveGroupViewModel">
                            <toolkit:SettingsExpander
                                Margin="0,0,0,6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Description="{x:Bind Description}"
                                Header="{x:Bind Name}"
                                IsExpanded="True"
                                ItemsSource="{x:Bind Cards}">
                                <toolkit:SettingsExpander.HeaderIcon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </toolkit:SettingsExpander.HeaderIcon>

                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="2"
                                    Visibility="{x:Bind ProjectActionsVisibility}">
                                    <Button
                                        AutomationProperties.Name="Restore project"
                                        Command="{x:Bind RestoreCommand}"
                                        ToolTipService.ToolTip="Restore project to the workspace">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon FontSize="12" Glyph="&#xE777;" />
                                            <TextBlock Text="Restore" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        AutomationProperties.Name="Delete project"
                                        Command="{x:Bind DeleteCommand}"
                                        ToolTipService.ToolTip="Delete project permanently">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                            <TextBlock Text="Delete" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <toolkit:SettingsExpander.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:ArchiveEntryViewModel">
                                        <toolkit:SettingsCard Description="{x:Bind Description}" Header="{x:Bind Name}">
                                            <toolkit:SettingsCard.HeaderIcon>
                                                <FontIcon Glyph="&#xE8A5;" />
                                            </toolkit:SettingsCard.HeaderIcon>

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="2"
                                                Visibility="{x:Bind ActionsVisibility}">
                                                <Button
                                                    AutomationProperties.Name="Restore card"
                                                    Command="{x:Bind RestoreCommand}"
                                                    ToolTipService.ToolTip="Restore card to the workspace">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <FontIcon FontSize="12" Glyph="&#xE777;" />
                                                        <TextBlock Text="Restore" />
                                                    </StackPanel>
                                                </Button>

                                                <Button
                                                    AutomationProperties.Name="Delete card"
                                                    Command="{x:Bind DeleteCommand}"
                                                    ToolTipService.ToolTip="Delete card permanently">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                                        <TextBlock Text="Delete" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </toolkit:SettingsCard>
                                    </DataTemplate>
                                </toolkit:SettingsExpander.ItemTemplate>
                            </toolkit:SettingsExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="42"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE7B8;" />
                <TextBlock
                    x:Name="EmptyStateTitle"
                    HorizontalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="Archive is empty" />
                <TextBlock
                    x:Name="EmptyStateDescription"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Projects and cards you archive from the workspace will appear here."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
